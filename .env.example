# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser. Used by admin screens and the seed script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shown in the header and on printed slips
NEXT_PUBLIC_COMPANY_NAME=Cambri Appliances

# Timezone for dates on screens and slips (servers run on UTC), e.g. Asia/Karachi, Asia/Dubai
NEXT_PUBLIC_APP_TIMEZONE=

# Public address printed in slip QR codes. Set it so slips made from any copy of the app open the live site.
NEXT_PUBLIC_SITE_URL=https://cambri-appliances.netlify.app
